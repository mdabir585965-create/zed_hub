rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['super_admin', 'admin'];
    }

    function isValidProduct(data) {
      return data.title is string
        && data.title.size() >= 2
        && data.title.size() <= 180
        && data.slug is string
        && data.slug.size() >= 2
        && data.price is number
        && data.price >= 0
        && data.stock is number
        && data.stock >= 0
        && data.published is bool;
    }

    function isValidAd(data) {
      return data.title is string
        && data.title.size() >= 2
        && data.placement in ['homepage_banner', 'category_page', 'bottom_page']
        && data.enabled is bool
        && data.priority is number;
    }

    match /admins/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /products/{productId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update: if isAdmin() && isValidProduct(request.resource.data);
      allow delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if resource.data.active == true || isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2;
      allow delete: if isAdmin();
    }

    match /banners/{bannerId} {
      allow read: if resource.data.active == true || isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 2;
      allow delete: if isAdmin();
    }

    match /ads/{adId} {
      allow read: if resource.data.enabled == true || isAdmin();
      allow create, update: if isAdmin() && isValidAd(request.resource.data);
      allow delete: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /admin_logs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }
  }
}
